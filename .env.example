# Cozy AI Productivity System — environment configuration
# Copy to `.env` and adjust values. NEVER commit `.env`.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                # text | json
DEBUG=false

# --- Database ---
# SQLite (dev default):
# DATABASE_URL=sqlite:///./cozy_productivity.db
# PostgreSQL (production / Docker Compose):
DATABASE_URL=postgresql://cozy:cozy_pass@db:5432/cozy_db

# --- Auth ---
# REQUIRED in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days
SEED_DEMO=false                     # seed demo user/tasks on startup (non-prod only)

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# --- RAG ---
RAG_PROVIDER=ollama             # ollama | openai | gemini | grok
CHROMA_PATH=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=8
RAG_RERANK_LIMIT=5
RAG_RELEVANCE_THRESHOLD=0.25
RAG_MAX_CONTEXT_CHARS=4000
RAG_MAX_SOURCES=5

# --- LLM providers ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROK_API_KEY=
GROK_MODEL=grok-beta

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_RAG_PER_MINUTE=30
RATE_LIMIT_GENERAL_PER_MINUTE=120

# --- RAG answer cache ---
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=128
