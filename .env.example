# === Cozy AI Productivity & RAG Tracker — Environment Configuration ===
# Copy this file to `.env` and adjust values. NEVER commit a real `.env`.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
DEBUG=false

# --- Database (SQLite for dev, PostgreSQL for prod/Compose) ---
DATABASE_URL=sqlite:///./cozy_productivity.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://cozy:cozy_password@postgres:5432/cozy

# --- Authentication ---
# REQUIRED in production. Leave empty in development for an auto-generated secret.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days
SEED_DEMO=false                     # create demo@cozy.app / cozy123 (development only)

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- RAG / Vector store ---
RAG_PROVIDER=ollama              # ollama | openai | gemini | grok
RAG_MODEL=
CHROMA_PATH=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=8
RAG_RERANK_LIMIT=5
RAG_RELEVANCE_THRESHOLD=0.25
RAG_MAX_CONTEXT_CHARS=4000
RAG_MAX_SOURCES=5

# --- LLM providers (optional; keys only needed for cloud providers) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_TIMEOUT_SECONDS=10.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROK_API_KEY=
GROK_MODEL=grok-beta
